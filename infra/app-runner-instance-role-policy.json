{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RepoReadyAuditTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:YOUR_ACCOUNT_ID:table/repoready-audits"
    },
    {
      "Sid": "RepoReadyProjectUploadAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::repoready-project-uploads/uploads/*"
    }
  ]
}
